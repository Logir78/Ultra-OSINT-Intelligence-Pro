# ==============================================================================
#  NOCTUA.osint — Backend environment
#  Copia este archivo a `.env` y rellena los valores. NUNCA subas el .env real.
# ==============================================================================

# ---- Base de datos (OBLIGATORIO — el backend no arranca sin esto) ------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=noctua

# ---- CORS --------------------------------------------------------------------
# Orígenes permitidos, separados por coma. En producción usa una allowlist
# explícita. NO uses "*" junto con credenciales de sesión.
CORS_ORIGINS=http://localhost:3000

# ---- URL pública del backend (para webhooks: Stripe, Telegram) ---------------
PUBLIC_BASE_URL=http://localhost:8001

# ---- IA (Claude / GPT / Gemini vía emergentintegrations) ---------------------
# Clave del proveedor LLM. Si falta, los módulos de IA se desactivan.
EMERGENT_LLM_KEY=

# ---- Modo acceso privado (opcional) ------------------------------------------
# Lista de emails autorizados (coma-separados). Vacío = acceso abierto.
AUTHORIZED_EMAILS=

# ---- Stripe (plan Pro) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (alertas vía Resend) ----------------------------------------------
RESEND_API_KEY=
SENDER_EMAIL=alerts@example.com

# ---- Proveedores OSINT (opcionales; cada módulo se activa si hay clave) -------
SHODAN_KEY=
ABUSEIPDB_KEY=
HIBP_KEY=
RAPIDAPI_KEY=
INTELX_KEY=
URLSCAN_KEY=

# ---- Proxy de integraciones (opcional) ---------------------------------------
INTEGRATION_PROXY_URL=

# ---- Seguridad (nuevo en la versión Pro) -------------------------------------
# Bloquea que el escáner apunte a IPs internas/privadas (anti-SSRF). 1=on 0=off.
SSRF_GUARD=1

# ---- Observabilidad y rate limiting (Fase 2) ---------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=plain          # 'json' para logs estructurados en producción
RATE_LIMIT_ENABLED=1
RATE_LIMIT_DEFAULT=240/minute   # límite global por IP (segundos/minutos/horas)

# ---- Auth nativa (Fase 4 · alternativa a Emergent OAuth) ---------------------
AUTH_NATIVE_ENABLED=1     # habilita /api/auth/register y /api/auth/login
SESSION_DAYS=7
COOKIE_SECURE=1           # 1 en producción (HTTPS). 0 para pruebas locales en http

# ---- LLM directo (Fase 4 · alternativa a Emergent) ---------------------------
# Si defines proveedor+clave, la IA usa litellm directo; si no, cae a Emergent.
DEFAULT_LLM_PROVIDER=     # anthropic | openai | gemini
DEFAULT_LLM_KEY=
DEFAULT_LLM_MODEL=        # opcional; si vacío usa un modelo por defecto del proveedor

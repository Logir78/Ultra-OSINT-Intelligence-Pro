# ==============================================================================
#  NOCTUA.osint — Frontend environment
#  Copia este archivo a `.env`. Las variables deben empezar por REACT_APP_.
# ==============================================================================

# URL del backend que consume el frontend (OBLIGATORIO).
REACT_APP_BACKEND_URL=http://localhost:8001

# URL de backend alternativa usada por los tests E2E (opcional).
REACT_APP_BACKEND_URL_TEST=

# Habilita el endpoint interno de health-check del dev server (opcional). 1=on.
ENABLE_HEALTH_CHECK=0
